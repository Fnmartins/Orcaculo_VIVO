{
  "cli": {
    "version": ">= 16.0.0",
    "promptToInstallDependencies": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://SEU_PROJETO.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "SUA_ANON_KEY_AQUI"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://SEU_PROJETO.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "SUA_ANON_KEY_AQUI"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://SEU_PROJETO.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "SUA_ANON_KEY_AQUI"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "SEU_APPLE_ID@email.com",
        "ascAppId": "SEU_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "SEU_TEAM_ID"
      }
    }
  }
}
